set_property LOC BUFGCTRL_X0Y2 [get_cells shift_register_reg[12]_i_1]
set_property LOC BUFGCTRL_X0Y3 [get_cells mprj_io_IBUF_BUFG[4]_inst]
set_property LOC BUFGCTRL_X0Y0 [get_cells hkspi_disable_reg_i_2]
set_property LOC BUFGCTRL_X0Y1 [get_cells dbg_hub/inst/BSCANID.u_xsdbm_id/SWITCH_N_EXT_BSCAN.u_bufg_icon_tck]
